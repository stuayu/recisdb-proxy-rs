# =====================================================
# recisdb-proxy 設定ファイル
# =====================================================
# このファイルを recisdb-proxy.toml にコピーして編集してください。
# コマンドライン引数が指定された場合、そちらが優先されます。

# =====================================================
# サーバー設定
# =====================================================
[server]
# プロキシサーバーの待ち受けアドレス (デフォルト: 0.0.0.0:40070)
# クライアント (TVTest等) はこのアドレスに接続します
listen = "0.0.0.0:40070"

# Webダッシュボードの待ち受けアドレス (デフォルト: 0.0.0.0:40080)
# ブラウザで http://localhost:40080 にアクセスすると管理画面が表示されます
web_listen = "0.0.0.0:40080"

# デフォルトのチューナーデバイスパス (省略可)
# Linux: /dev/pt3video0 または DVBデバイスの場合 0|0 → /dev/dvb/adapter0/frontend0
# Windows: BonDriver DLLのフルパス
# 複数チューナーはWebダッシュボードまたはDBで管理します
# tuner = "/dev/pt3video0"
# tuner = "C:\\BonDriver\\BonDriver_PX-MLT1.dll"

# 最大同時接続数 (デフォルト: 64)
# 同時に接続できるクライアント数の上限
max_connections = 64

# =====================================================
# データベース設定
# =====================================================
[database]
# SQLiteデータベースファイルのパス (デフォルト: recisdb-proxy.db)
# 初回起動時に自動作成されます
path = "recisdb-proxy.db"

# =====================================================
# ログ設定
# =====================================================
# ログレベル・保持日数はこのファイルではなく、Webダッシュボードの
# 「設定 > ログ出力」から変更してください（データベースに保存され、
# レベルの変更は再起動なしで即座に反映されます）。
# ログの出力先ディレクトリのみ、起動時のコマンドライン引数
# `--log-dir` (デフォルト: logs) で指定します。

# =====================================================
# Webダッシュボード/API認証設定
# =====================================================
[web]
# /api/* に Authorization: Bearer <トークン> を要求する (デフォルト: true)
# false は隔離されたLANでのテスト専用です
auth_enabled = false
#
# 認証トークンを明示指定する (省略可)
# 未指定の場合は初回起動時に自動生成されDBに保存されます。
# 認証有効時、実際に使われるトークンは毎回起動ログに表示されます
# auth_token = "任意のトークン文字列"

# =====================================================
# Mirakurun互換API設定
# =====================================================
[mirakurun]
# /mirakurun/api/* を有効にする (デフォルト: false)
# このエンドポイントは認証なしで公開されるため(実際のMirakurunクライアント
# はAuthorizationヘッダを送らないため)、信頼できるネットワークでのみ
# 有効にしてください
enabled = true

# =====================================================
# BNDPセッション (TVTest等) 用エンコーダ設定
# =====================================================
# 実行ファイルのパスはこの設定ファイルからのみ変更できます
# (Web APIから変更可能にするとリモートコード実行の踏み台になるため)。
# 有効/無効の切り替えや引数はWebダッシュボードから設定します。
[tsreplace]
# エンコーダ実行ファイルのパス (例: tsreplace)
command_path = "C:\\DTV\\tsreplace\\tsreplace.exe"
#
# 前段プロセスの実行ファイルパス (省略可、例: tsreadex)
# 設定するとパイプライン TS → 前段 → エンコーダ → 出力 で実行されます。
# 空文字列を指定すると保存済みの値をクリアできます
# preprocessor_path = "C:\\DTV\\tsreadex\\tsreadex.exe"

# =====================================================
# ブラウザプレビュー (?profile=preview) 用エンコーダ設定
# =====================================================
# [tsreplace] とは完全に独立した設定です。パスがTOML専用である理由も同じ。
# 有効/無効・前段引数はWebダッシュボードの「ブラウザプレビュー」設定から。
# 引数内の {SID} は対象サービスIDに置換されます。
#
# 引数は初回起動時に推奨値がDBへ自動登録されます (ダッシュボードから変更可):
#   前段 (tsreadex):    -x 18/38/39 -n {SID} -a 13 -b 5 -c 1 -u 1 -d 13 -
#   エンコーダ (QSVEncC): H.264 ~2Mbps VBR / インターレース解除 / AAC ステレオ
#                        (encode_profiles の preview-h264 プロファイル)
# ここでは実行ファイルのパス2つを設定するだけで動作します。
# サービス選択は前段 tsreadex の -n {SID} が担うため、前段の設定を推奨します。
[preview]
# プレビュー用エンコーダの実行ファイルパス (例: QSVEncC)
command_path = "C:\\DTV\\KonomiTV\\server\\thirdparty\\QSVEncC\\QSVEncC.exe"
#
# 前段プロセスの実行ファイルパス (例: tsreadex によるサービス選択)
preprocessor_path = "C:\\DTV\\KonomiTV\\server\\thirdparty\\tsreadex\\tsreadex.exe"

# =====================================================
# TLS設定 (tls フィーチャーが有効な場合のみ)
# =====================================================
# [tls]
# TLS暗号化を有効にする (デフォルト: false)
# enabled = false
#
# CA証明書のパス (PEM形式)
# ca_cert = "ca.pem"
#
# サーバー証明書のパス (PEM形式)
# server_cert = "server.pem"
#
# サーバー秘密鍵のパス (PEM形式)
# server_key = "server-key.pem"
#
# クライアント証明書の要求 (デフォルト: false)
# true にするとクライアント証明書がない接続は拒否されます
# require_client_cert = false

# =====================================================
# BS4K (MMT/TLV) 変換設定
# =====================================================
# 4Kチューナーは MPEG-2 TS ではなく MMT/TLV を出力します。本体が生の
# MMT/TLV を読み出し、この設定の変換器 (dantto4k) にパイプで渡して TS へ
# 変換してから配信します。
#
# 使うには、対象の BonDriver を stream_format = 'mmttlv' として登録します:
#   UPDATE bon_drivers SET stream_format = 'mmttlv' WHERE dll_path = '...';
#
# 詳細は docs/FOURK_SETUP.md を参照してください。
# [mmttlv]
# dantto4k の実行ファイルのパス
# (実行ファイルのパスは [tsreplace] と同じ理由でこの設定ファイルからのみ
#  指定できます。Web API から変更可能にするとリモートコード実行の踏み台に
#  なるため)
# command_path = "C:\\DTV\\BonDriver\\dantto4k.exe"
#
# --- ACAS 復号の設定 (どちらか一方が必須) ---
# 変換器がスクランブル解除まで行います。どちらも設定しないと、変換自体は
# 成功するのに復号されていない TS が出力され、「変換は通るのに再生できない」
# 状態になります。この場合サーバーログに警告が出ます。
#
# CasProxyServer のアドレス
# 指定しても実際にサーバーが起動していないと、変換器はローカルの PC/SC に
# フォールバックし "No smart card readers are available" を出します
# cas_proxy_server = "127.0.0.1:24000"
#
# A-CAS カードを読む PC/SC リーダー名
# 正確な名前は `dantto4k.exe --listSmartCardReader` で確認できます
# smart_card_reader_name = ""
#
# 前段で復号済みの場合に指定します (--frontend-descrambled)。
# 生のチューナー出力を読む通常の構成では **false のままにしてください**。
# スクランブルされたままの入力にこれを指定すると、警告なしで再生できない
# TS が出力されます
# frontend_descrambled = false
#
# その他の引数をそのまま渡します
# extra_args = ["--disableADTSConversion"]
